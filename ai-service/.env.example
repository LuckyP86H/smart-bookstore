# AI Service Configuration
# Copy to .env and fill in real values. .env is gitignored — never commit secrets.

# Server
APP_NAME=Bookstore AI Service
APP_VERSION=1.0.0
HOST=0.0.0.0
PORT=8000

# ============================================================================
# LLM Configuration (via LiteLLM — provider is chosen by the model string)
# ============================================================================
# Examples:
#   Ollama (local):  LLM_MODEL=ollama/llama3.2         (+ LLM_API_BASE below)
#   OpenAI:          LLM_MODEL=gpt-4o-mini             (+ OPENAI_API_KEY)
#   Anthropic:       LLM_MODEL=claude-sonnet-5         (+ ANTHROPIC_API_KEY)
#   DeepSeek:        LLM_MODEL=deepseek/deepseek-chat  (+ DEEPSEEK_API_KEY)
#   Gemini:          LLM_MODEL=gemini/gemini-2.0-flash (+ GEMINI_API_KEY)
LLM_MODEL=ollama/llama3.2
# Ollama endpoint (only used for ollama/* models; defaults to http://localhost:11434).
# Inside docker-compose, use http://host.docker.internal:11434
#LLM_API_BASE=http://host.docker.internal:11434
# For a custom OpenAI-compatible proxy, use LiteLLM's native vars instead, e.g. OPENAI_BASE_URL.
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500

# Provider API keys (set only the one(s) you use; read by LiteLLM)
#OPENAI_API_KEY=
#ANTHROPIC_API_KEY=
#DEEPSEEK_API_KEY=
#GEMINI_API_KEY=

# Database (PostgreSQL with pgvector)
DB_HOST=database
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bookstore

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# Vector Search
VECTOR_SEARCH_LIMIT=10
VECTOR_SIMILARITY_THRESHOLD=0.35

# CORS (browsers talk to the Go backend, not this service — dev origins only)
CORS_ORIGINS=["http://localhost:3000"]
