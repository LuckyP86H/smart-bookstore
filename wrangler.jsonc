{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "smart-bookstore",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-25",
  // nodejs_compat is required by the postgres.js driver used through Hyperdrive.
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Route B: the Worker reaches Supabase Postgres through Hyperdrive
  // (connection pooling). The origin credentials live inside the Hyperdrive
  // config itself, never in this file. Config name: smart-bookstore
  // (origin: Supabase session pooler, aws-1-ca-central-1, db "postgres").
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "29bdf1a02ce74d38816db8ff825cc4cd"
    }
  ],

  // Login rate limiting (Workers rate-limiting binding; GA and available
  // on the Free plan — verified live on this account 2026-11-05, see
  // DEPLOY.md "Route B P2"). Provisioned automatically from this config
  // at deploy time; nothing to create in the dashboard. Enforced in
  // worker/src/auth/rate-limit.ts on /bookstore.v1.* and /api/ai/chat:
  // 60 attempts per minute per client IP, then HTTP 429.
  "ratelimits": [
    {
      "name": "LOGIN_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 60, "period": 60 }
    }
  ],

  // Route B P4: Workers AI binding, used by worker/src/ai/embeddings.ts.
  // The model id itself is configuration (the EMBEDDING_MODEL var below),
  // never hardcoded in code (plan §6).
  "ai": { "binding": "AI" },

  // The React build (see "build" in package.json). The Worker runs first only
  // for API paths; every other request is answered from these static assets.
  "assets": {
    "directory": "./frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/bookstore.v1.*", "/api/*"]
  },

  // Two containers, each a Durable Object class exported from worker/src/index.ts.
  // Each image builds from its own folder (the Dockerfiles expect that context).
  "containers": [
    {
      "class_name": "BackendContainer",
      "image": "./backend/Dockerfile",
      "image_build_context": "./backend",
      "max_instances": 1,
      "instance_type": "basic"
    },
    {
      // torch + the embedding model need more than the 1 GiB "basic" size.
      "class_name": "AiServiceContainer",
      "image": "./ai-service/Dockerfile",
      "image_build_context": "./ai-service",
      "max_instances": 1,
      "instance_type": "standard-1"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "BACKEND", "class_name": "BackendContainer" },
      { "name": "AI_SERVICE", "class_name": "AiServiceContainer" }
    ]
  },
  "exports": {
    "BackendContainer": { "type": "durable-object", "storage": "sqlite" },
    "AiServiceContainer": { "type": "durable-object", "storage": "sqlite" }
  },

  // Non-secret settings. Confirm DB_HOST / DB_USER in the Supabase dashboard:
  // Connect → Session pooler (the direct host is IPv6-only).
  // Secrets are NOT here; set DB_PASSWORD and OLLAMA_API_KEY in the Cloudflare
  // dashboard (Settings → Variables and Secrets), see DEPLOY.md.
  "vars": {
    "DB_HOST": "aws-1-ca-central-1.pooler.supabase.com",
    "DB_PORT": "5432",
    "DB_USER": "postgres.lakylendodavkbagffqc",
    "DB_NAME": "postgres",
    "DB_SSLMODE": "require",
    // The schema comes from supabase/migrations/, so the Go backend must not create tables itself.
    "DB_INIT_SCHEMA": "false",
    // PBKDF2 iterations for password records (Route B P2). Settled
    // 2026-11-05 at the design's minimum defensible count (owner
    // decision, option B: stay on Free): the 2026-11-05 staging
    // benchmarks found no count — 1k through 100k — meeting the
    // Free-plan CPU budget at p95, and lowering buys ~0 ms at p95
    // (design §5.4 stop-and-escalate — see DEPLOY.md), so 10000 is
    // final on Free. On Workers Paid, raise to "100000". The
    // PASSWORD_PEPPER secret is set in the dashboard, never here.
    "PBKDF2_ITERATIONS": "10000",
    "LLM_MODEL": "ollama/beam:cloud",
    "LLM_API_BASE": "https://ollama.com",
    // Workers AI embedding model (Route B P4, plan §6): read by
    // worker/src/ai/embeddings.ts via env.EMBEDDING_MODEL.
    "EMBEDDING_MODEL": "@cf/baai/bge-m3"
  }
}
